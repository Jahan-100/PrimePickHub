{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/product/:slug", "destination": "/product.html?slug=:slug" },
    { "source": "/category/:cat", "destination": "/category.html?cat=:cat" },
    { "source": "/blog/:slug", "destination": "/article.html?slug=:slug" },
    { "source": "/api/geo", "destination": "/api/geo.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/check-status", "schedule": "0 3 * * *" }
  ]
}
