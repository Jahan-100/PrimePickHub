{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/product/:slug", "destination": "/product.html?slug=:slug" },
    { "source": "/category/:cat", "destination": "/category.html?cat=:cat" },
    { "source": "/api/geo", "destination": "/api/geo.js" }
  ],
  "crons": [
    { "path": "/api/check-status", "schedule": "0 3 * * *" }
  ]
}
